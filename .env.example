# Cantina environment. Copy to .env (npm run setup does this) and fill in the [HUMAN] values.
# Secrets live here only. .env is gitignored. See docs/SETUP-DISCORD.md.

# [HUMAN] Bot token from the Discord Developer Portal → Bot → Reset Token. Never share or commit.
DISCORD_TOKEN=
# [HUMAN] Application ID from General Information.
DISCORD_CLIENT_ID=
# [HUMAN] Your server's ID (Developer Mode on → right-click server → Copy Server ID).
DISCORD_GUILD_ID=
# [HUMAN] Colon-separated library roots (read-only to Cantina), e.g.
# /Users/ant/Music/Cantina/Soundtracks:/Users/ant/Music/Cantina/SFX
CANTINA_LIBRARY_PATHS=
# Dashboard and API port (binds to 127.0.0.1 unless LAN mode is on).
CANTINA_PORT=4242
# Port for the local speech sidecar (always 127.0.0.1).
CANTINA_EARS_PORT=4243
# LAN / iPad mode (SPEC §12.10). Off by default; requires a PIN when on.
CANTINA_LAN=false
# Optional: AcoustID API key for the MusicBrainz enrichment provider (off by default).
ACOUSTID_API_KEY=
# Optional: local Ollama, e.g. http://127.0.0.1:11434
OLLAMA_URL=
# Optional: data directory (defaults to ./data).
CANTINA_DATA_DIR=
# Optional: log level (debug, info, warn, error). Logs record decisions, never speech.
CANTINA_LOG_LEVEL=info
